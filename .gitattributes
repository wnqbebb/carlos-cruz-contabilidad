# Archivos binarios: git no debe tocar sus fines de línea.
*.pdf binary
*.xlsx binary
*.xls binary
*.xlsm binary
*.docx binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary

# Los .bat de Windows necesitan CRLF (cmd falla con etiquetas si solo hay LF).
*.bat text eol=crlf
# Los hooks y scripts de shell necesitan LF.
.githooks/* text eol=lf
*.sh text eol=lf
