# ─────────────────────────────────────────────────────────────────────────────
#  CARLOS CRUZ · configuración del backend
#  Copie este archivo como  backend/.env  y pegue los valores reales.
#  El archivo .env NUNCA se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# 1) Cadena de conexión a Postgres de Supabase.
#    Supabase → Project Settings → Database → Connection string → URI
#    IMPORTANTE: use el puerto 6543 (pooler) y agregue ?sslmode=require
#    Reemplace [SU-CLAVE] por la contraseña de la base de datos.
DATABASE_URL=

# 2) Datos del proyecto Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# 3) Orígenes del frontend autorizados a llamar la API (separados por coma).
#    En local no hace falta cambiarlo. Al desplegar agregue la URL de Vercel.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# 4) Clave para firmar las sesiones de trabajo. Genere una cualquiera larga.
CLAVE_SESION=

# 5) Modo de almacenamiento: "supabase" o "local".
#    "local" usa SQLite en datos_app/ y no necesita nada de lo anterior.
ALMACENAMIENTO=local
